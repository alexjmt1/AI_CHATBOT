# Get a key at https://platform.openai.com/api-keys (must belong to the org that holds your credits)
OPENAI_API_KEY=sk-...

# Login for the app (set the same names in Vercel > Settings > Environment Variables)
APP_USERNAME=your-username
APP_PASSWORD=your-password

# Optional: long random string used to sign login cookies (falls back to a value derived from the login)
SESSION_SECRET=

# Optional: cap on reply length per request (default 4000)
MAX_OUTPUT_TOKENS=4000
